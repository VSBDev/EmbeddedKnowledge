    {
      "id": "objective-identify-family",
      "statement": "Distinguish direct, inverse, and general power-law models using equations, scale-factor behavior, tables, and invariant ratios or products.",
      "outcomeIds": [
        "topic-quantitative-foundations-proportional-models"
      ]
    },
    {
      "id": "objective-parameterize-model",
      "statement": "Recover a proportionality constant and power exponent from exact data, and evaluate a supplied proportional model against approximate observations.",
      "outcomeIds": [
        "topic-quantitative-foundations-proportional-models"
      ]
    },
    {
      "id": "objective-predict-scaling",
      "statement": "Predict responses under changes in the input using y = kx^p and compare predictions with observed values or residuals.",
      "outcomeIds": [
        "topic-quantitative-foundations-proportional-models"
      ]
    },
    {
      "id": "objective-log-linearize",
      "statement": "Linearize a positive-variable power law on logarithmic coordinates and interpret log-log slope as the exponent and intercept as the logarithm of the constant.",
      "outcomeIds": [
        "topic-quantitative-foundations-proportional-models"
      ]
    }
  ],
