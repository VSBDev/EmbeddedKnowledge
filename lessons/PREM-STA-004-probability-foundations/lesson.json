    {
      "id": "objective-probability-from-counts",
      "statement": "Compute the probability of an event by counting equally likely outcomes, apply the complement rule, and state what the resulting number promises about a long run of repetitions.",
      "outcomeIds": [
        "topic-statistics-data-probability"
      ]
    },
    {
      "id": "objective-combine-two-events",
      "statement": "Apply the addition rule with and without overlap, test two events for independence, and select between the plain and the conditional form of the multiplication rule with a stated justification.",
      "outcomeIds": [
        "topic-statistics-data-probability"
      ]
    },
    {
      "id": "objective-separate-the-conditionals",
      "statement": "Compute P(A given B) and P(B given A) from one table, explain why the two differ, and identify the inverted conditional in a screening, test-result, or study-result claim.",
      "outcomeIds": [
        "topic-statistics-data-probability"
      ]
    },
    {
      "id": "objective-reject-short-run-correction",
      "statement": "Explain why a run of like outcomes leaves the next independent trial's probability unchanged, and state what the law of large numbers does and does not promise about a growing record.",
      "outcomeIds": [
        "topic-statistics-data-probability"
      ]
    }
  ],
