  "title": "What p = 0.029 claims, and what it does not",
  "language": "en",
  "outcomes": [
    "topic-statistics-data-hypothesis-tests"
  ],
  "prerequisites": [
    "topic-statistics-data-sampling-standard-error"
  ],
  "objectives": [
    {
      "id": "objective-state-hypotheses",
      "statement": "State the null and alternative hypotheses for a two-group comparison, and explain what the null contributes as one assumption inside a wider statistical model.",
      "outcomeIds": [
        "topic-statistics-data-hypothesis-tests"
      ]
    },
    {
      "id": "objective-compute-and-read-p",
      "statement": "Compute a test statistic from an observed difference and its standard error, locate it on the null distribution, and state precisely what the resulting two-sided p-value is the probability of.",
      "outcomeIds": [
        "topic-statistics-data-hypothesis-tests"
      ]
    },
    {
      "id": "objective-separate-p-from-claims",
      "statement": "Distinguish a p-value from the probability that the null is true, from the probability that chance produced the result, and from any measure of effect size, and repair a stated claim that confuses them.",
      "outcomeIds": [
        "topic-statistics-data-hypothesis-tests"
      ]
    },
    {
      "id": "objective-threshold-and-interval",
      "statement": "Explain why the 0.05 cut-off is a convention distinct from the computed p-value, and demonstrate that a 95 per cent interval excluding zero and a p-value below 0.05 are one result described twice.",
      "outcomeIds": [
        "topic-statistics-data-hypothesis-tests"
      ]
    },
    {
      "id": "objective-judge-with-effect-and-design",
      "statement": "Interpret a reported p-value alongside the effect size, its interval, and the study's design quality, and explain why a p-value above the cut-off does not establish the absence of an effect.",
      "outcomeIds": [
        "topic-statistics-data-hypothesis-tests"
      ]
    }
  ],
